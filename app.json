{
  "expo": {
    "name": "lance-raro",
    "slug": "lance-raro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#2C1B12"
    },
    "ios": {
      "supportsTablet": true,
      // Adicionando a configuração de splash aqui também para garantir a compatibilidade
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#2C1B12"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "splash": {
        "image": "./assets/logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#2C1B12"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
